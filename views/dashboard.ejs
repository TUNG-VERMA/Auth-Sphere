<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>
</head>
<body>
    <h1>Dashboard</h1>

    <p>Hello, <%= user.name %></p>
    <p>Email: <%= user.email %></p>
    <p>Role: <%= user.role %></p>

    <% if (user.role === 'admin') { %>
        <a href="/admin">Go to Admin Panel</a>
        <br><br>
    <% } %>

    <a href="/logout">Logout</a>
</body>
</html>